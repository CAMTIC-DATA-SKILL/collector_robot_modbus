# 이 파일을 .env 로 복사해서 쓴다. 비워 둔 값은 config.py 의 기본값을 따른다.

# 메모리 맵 JSON (저장소 루트 기준 상대경로 또는 절대경로)
# 쉼표로 여러 개를 주면 순서대로 합친다. word_endian/max_gap/format 은 첫 번째(기준) 파일에만 둔다
# 예) 쓰기가 생기는 sockets 만 따로 리뷰할 때: memory_map.json,sockets.json
MEMORY_MAP_FILE=memory_map.json

# 소켓 command 카탈로그 CSV (로봇 모델별 매뉴얼 전사). 맵에 sockets 가 없으면 비워 둔다
# 예) profiles/hi6/hi6_s_relay_command_catalog.csv
COMMAND_CATALOG_FILE=

# 수집 루프
# tcp | rtu
MODBUS_MODE=tcp
POLL_INTERVAL_SEC=1.0
RECONNECT_INTERVAL_SEC=5.0

# 로깅: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# 게이트웨이 IPC (ZeroMQ). data/health/ack PUB, cmd_r/cmd_w SUB
# 토픽: collector.robot.{DEVICE_KEY}.{msg_type}. DEVICE_KEY 에 '.' 금지
DEVICE_KEY=robot-1
GATEWAY_ADDRESS=gateway
# PUB 포트는 같은 edge 의 다른 collector(collector-plc 등)와 겹치면 안 된다
ZMQ_PUB_ENDPOINT=tcp://127.0.0.1:5557
# 게이트웨이 PUB 주소
ZMQ_SUB_ENDPOINT=tcp://127.0.0.1:5555
ZMQ_PUB_BIND=true
ZMQ_SUB_BIND=false
ZMQ_RECV_TIMEOUT_MS=100
ZMQ_LINGER_MS=0

# Modbus TCP
MODBUS_TCP_HOST=127.0.0.1
MODBUS_TCP_PORT=502
MODBUS_TCP_DEVICE_ID=1
MODBUS_TCP_TIMEOUT=3.0
MODBUS_TCP_RETRIES=3

# Modbus RTU
MODBUS_RTU_PORT=/dev/ttyUSB0
MODBUS_RTU_BAUDRATE=9600
MODBUS_RTU_BYTESIZE=8
# N | E | O
MODBUS_RTU_PARITY=N
MODBUS_RTU_STOPBITS=1
MODBUS_RTU_LOCAL_ECHO=false
MODBUS_RTU_DEVICE_ID=1
MODBUS_RTU_TIMEOUT=3.0
MODBUS_RTU_RETRIES=3
